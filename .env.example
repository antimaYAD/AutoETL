# Copy this file to .env and fill in real values. Never commit .env.
# Never put real credentials in this .env.example template either --
# it's meant to be a tracked placeholder, not a secrets file.

APP_NAME=AutoETL
DEBUG=true

# Option A: set the full connection string directly.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://autoetl:autoetl@localhost:5432/autoetl

# Option B: set these instead and DATABASE_URL will be assembled for you
# (see app/config.py). Leave blank / remove if you're using DATABASE_URL above.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=autoetl
# DB_USER=autoetl
# DB_PASSWORD=change-me

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=100
